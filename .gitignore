cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual Environments
venv/
ENV/
env/
.env
.env.*

# Selenium/Behave Reports & Artifacts
reports/
screenshots/
videos/
*.log
allure-results/
behave.log

# IDE/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Behave
.behave/

# Local overrides
*.local.py
config.local.yaml
EOF